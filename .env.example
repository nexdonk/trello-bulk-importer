# Trello credentials. Get your API key at https://trello.com/power-ups/admin
# and generate a token from the key's page. You can also set these from the
# app's Settings page, which writes them to this file (.env) for you.
TRELLO_API_KEY=
TRELLO_API_TOKEN=

# Server binding. Keep HOST=127.0.0.1 unless you know what you are doing.
HOST=127.0.0.1
PORT=3000

# Maximum CSV upload size in megabytes.
MAX_UPLOAD_MB=5
